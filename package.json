{
  "name": "vuldetected",
  "version": "0.1.0",
  "private": true,
  "description": "VulDetected — web application security scanning with actionable remediation code.",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @vuldetected/web exec vitest run --config vitest.e2e.config.ts",
    "seed:demo": "node apps/web/scripts/seed-demo-users.mjs",
    "scheduler:dev": "node apps/web/scripts/run-scheduler.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^14.6.0",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  }
}
