# =============================================================================
# VulDetected — environment variables (single source of truth)
# =============================================================================
# Copy this file to `.env` and fill in the blanks:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.
#
# PROVIDER NOTE
# If you choose Supabase instead of the local Docker Postgres, the ONLY change
# required is to replace DATABASE_URL below with the connection string Supabase
# gives you. No code change is needed — the data layer is provider-neutral
# (see docs/adr/0004-database-provider-neutrality.md and docs/database.md).

# --- Database ---
# Local Docker Postgres (infra/docker-compose.dev.yml).
# Supabase example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require

# --- Auth ---
# Session signing secret. MUST be 32+ bytes. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email ---
# Local mail is provided by Mailpit: SMTP on 1025, web inbox on http://localhost:8025
# Production REQUIRES SMTP_HOST and EMAIL_FROM; the app refuses to boot without
# them rather than silently delivering everything to localhost.
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave both empty for Mailpit (unauthenticated SMTP). Real providers need both.
SMTP_USER=
SMTP_PASSWORD=
# Implicit TLS on port 465. Use `false` for 1025 and 587 (STARTTLS is negotiated).
SMTP_SECURE=false
EMAIL_FROM=VulDetected <noreply@vuldetected.local>
# Bearer secret for POST /api/mail/dispatch, the outbox flush endpoint.
# 16+ characters. When empty the endpoint refuses every request.
MAIL_DISPATCH_SECRET=

# --- Scanner (Sprint 2) ---
# Redis broker for the Python Celery worker (services/scanner).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Shared secret for the worker's authenticated callback. Dev-grade: generate a
# real value outside local development.
SCANNER_CALLBACK_SECRET=dev-scanner-callback-secret
# Egress policy for the worker: `strict` in normal use, `test` only for the
# hermetic E2E fixture network.
SCANNER_EGRESS_MODE=strict

# --- Scheduler (scripts/run-scheduler.mjs) ---
# Origin the scheduler calls. It uses the same bearer secret as the scanner
# callback, so SCANNER_CALLBACK_SECRET is the only credential to set.
SCHEDULER_BASE_URL=http://localhost:3000
# How often the scheduler asks the app for due schedules, in milliseconds.
SCHEDULER_INTERVAL_MS=60000

# --- Scan credentials ---
# Seals the usernames, passwords and tokens the scanner uses to reach pages
# behind a login. Base64 of exactly 32 raw bytes; a passphrase is rejected.
#   openssl rand -base64 32
# Required in production, optional in development (a domain without a credential
# never needs it).
CREDENTIALS_ENCRYPTION_KEY=
# Rotation: move the old value here and raise the version, then re-save each
# credential at leisure. Only one version back is readable.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
CREDENTIALS_ENCRYPTION_KEY_VERSION=1

# --- OAuth (optional) ---
# Leave empty to hide the provider buttons entirely. The buttons are rendered
# from the SAME resolution the auth instance uses (lib/auth/social.ts), so a
# button never appears for a provider that is not registered. There are no
# NEXT_PUBLIC_* switches: those could disagree with the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Simulated OAuth provider (DEMO ONLY) ---
# Stands in for Google and GitHub when no real credentials exist, so the social
# sign-in flow (CA-30/31/32) can be exercised and recorded end to end. Requires
# DEMO_MODE=true. Production refuses to boot if any of these are set.
# pnpm dev:all starts the provider on this port when OAUTH_DEMO_BASE_URL is set.
OAUTH_DEMO_BASE_URL=
OAUTH_DEMO_PORT=8100
OAUTH_DEMO_GOOGLE_CLIENT_ID=
OAUTH_DEMO_GOOGLE_CLIENT_SECRET=
OAUTH_DEMO_GITHUB_CLIENT_ID=
OAUTH_DEMO_GITHUB_CLIENT_SECRET=

# --- Simulated payment provider (DEMO ONLY) ---
# Signs the webhook the simulated checkout page delivers (HU-02b, ADR 0019).
# Requires DEMO_MODE=true and at least 16 characters. Production refuses to boot
# with this set on its own: a demo-signed webhook is a free-upgrade endpoint.
DEMO_PAYMENT_WEBHOOK_SECRET=

# --- Demo and deployment guards ---
# Leave all demo switches OFF outside a local demo. Production refuses to start
# if DEMO_MODE or DEMO_ALLOW_PRIVATE_TARGETS is true.
DEMO_MODE=false
DEMO_ALLOW_PRIVATE_TARGETS=false
SCAN_REQUIRE_VERIFIED_DOMAIN=true

# --- Logging ---
LOG_LEVEL=debug
