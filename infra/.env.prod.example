# =============================================================================
# VulDetected — production stack variables
# =============================================================================
# Copy this file and fill it in:
#
#   cp infra/.env.prod.example infra/.env.prod
#
# `infra/.env.prod` is git-ignored and excluded from the Docker build context.
# Anyone who can read it can read every scan credential in the database, so treat
# it as a secret, not as configuration.
#
# The variable names below are not a wish list: they are read by the code and by
# `infra/docker-compose.prod.yml`. A name that appears here and nowhere else is a
# bug in this file; a name the code reads and this file lacks is a boot failure.
# `apps/web/src/lib/env.ts` is the authority for *validity*; this file documents
# *what to put in it*.
#
# Variables marked REQUIRED use `${VAR:?}` in the Compose file, which makes
# `docker compose up` refuse to start instead of booting with a silent
# development default. That is deliberate.
# =============================================================================

# --- Database ----------------------------------------------------------------
# The compose stack's own Postgres. The host part is the service name `postgres`
# because the web container resolves it on the default network.
#
# Change POSTGRES_PASSWORD to a long random value BEFORE the first boot: the
# volume is initialized once and the password is baked into it.
#   openssl rand -base64 24
POSTGRES_USER=vuldetected
POSTGRES_PASSWORD=
POSTGRES_DB=vuldetected
DATABASE_URL=postgresql://vuldetected:CHANGE_ME@postgres:5432/vuldetected?schema=public

# --- Auth --------------------------------------------------------------------
# REQUIRED. Signs sessions; MUST be at least 32 bytes.
#   openssl rand -base64 32
AUTH_SECRET=
# REQUIRED. The public origin, with scheme and no trailing slash. OAuth
# redirects and emailed links are built from it, so a wrong value produces
# links to localhost.
AUTH_URL=https://vuldetected.example.com
# Public copy of the same origin, used by client components.
NEXT_PUBLIC_APP_URL=https://vuldetected.example.com

# --- Email -------------------------------------------------------------------
# REQUIRED. Production refuses to boot without a real SMTP host: the fallback
# would deliver every verification and reset email to a local Mailpit that does
# not exist in the container, and nobody would ever receive one.
SMTP_HOST=smtp.example.com
# 587 with STARTTLS is the common default; 465 means SMTP_SECURE=true.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# `true` only for implicit TLS on port 465. STARTTLS on 587 is `false`.
SMTP_SECURE=false
# REQUIRED. The From address. Most providers reject a domain that is not
# verified with them, so this must match the sender domain you configured.
EMAIL_FROM=VulDetected <no-reply@vuldetected.example.com>
# REQUIRED. Bearer secret for POST /api/mail/dispatch, the outbox flush
# endpoint. 16+ characters.
#   openssl rand -base64 32
MAIL_DISPATCH_SECRET=

# --- Scanner -----------------------------------------------------------------
# REQUIRED. Shared between the web app, the scheduler and the Python worker: it
# authenticates both the worker's callback and the scheduler's tick. Since it
# guards an endpoint that writes findings, generate a real value even in a demo.
#   openssl rand -base64 32
SCANNER_CALLBACK_SECRET=
# `strict` blocks private and loopback targets (SSRF protection). `test` exists
# only for the hermetic E2E fixture network — never set it here.
SCANNER_EGRESS_MODE=strict

# --- Scheduled scans ---------------------------------------------------------
# Runs inside the stack (`scheduler` service calls `web`), so the default is
# correct and normally needs no change.
SCHEDULER_INTERVAL_MS=60000
# Only the host-facing port knobs. Keep the app bound to loopback unless a
# reverse proxy on the same host terminates TLS.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- Scan credentials --------------------------------------------------------
# REQUIRED. Seals the usernames, passwords and tokens the scanner uses to reach
# pages behind a login (AES-256-GCM). Base64 of exactly 32 raw bytes; a
# passphrase is rejected at boot.
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Rotation only: move the previous key here, raise the version, then re-save each
# credential. One version back is readable; never set it on a fresh install.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
CREDENTIALS_ENCRYPTION_KEY_VERSION=1

# --- OAuth (optional) --------------------------------------------------------
# Leave empty to hide the provider buttons entirely. The redirect URI to register
# with each provider is `<AUTH_URL>/api/auth/callback/<provider>`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Browser-visible switches for the buttons ("true" to enable).
NEXT_PUBLIC_GOOGLE_ENABLED=
NEXT_PUBLIC_GITHUB_ENABLED=

# --- Logging -----------------------------------------------------------------
# pino level: trace | debug | info | warn | error | fatal. `info` in production;
# `debug` writes request-level detail that is a cost and a disclosure surface.
LOG_LEVEL=info

# --- Optional: Mailpit profile ----------------------------------------------
# `docker compose --profile mail` starts a mail catcher on 127.0.0.1:8025. To use
# it for a demo, point the two variables below at it instead of a real server.
# It accepts every message and delivers none: never do this for real users.
#
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_SECURE=false
